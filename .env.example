# Environmental Configurations Template for Anshuman Maurya Portfolio
# Copy this file to .env and adjust values for local development/production deployment.

# Environment configuration: development / production
PORTFOLIO_ENV=development

# Web Server Bindings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Security Configuration
# Change this secret key in production if session encryption is required
SECRET_KEY=dev-session-encryption-key-replace-this-in-production

# Homelab API Settings
# If you later connect this portfolio to a real monitoring daemon running on your home server,
# configure the authorization endpoint and tokens here.
REAL_MONITOR_API_URL=https://api.anshuman.sys/status
REAL_MONITOR_API_TOKEN=your-homelab-status-agent-token
